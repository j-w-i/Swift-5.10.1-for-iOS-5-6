+      // Older-than-iOS-5 and other architectures/platforms retain the generic error.
+      if !parsedOptions.hasArgument(.enableLegacyIos5Runtime),
+         targetTriple.vendor == .apple, targetTriple.archName == "armv7",
+         targetTriple.darwinPlatform == .iOS(.device),
+         targetTriple.version(for: platform) >= Triple.Version(5, 0, 0) {
+        throw ToolchainValidationError.legacyIOSDeploymentRequiresOptIn
+      }
       throw ToolchainValidationError.osVersionBelowMinimumDeploymentTarget(platform: platform, version: minVersion)
     }
 
