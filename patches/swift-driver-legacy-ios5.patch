       commandLine.appendFlag("-darwin-target-variant=\(variantTriple.triple)")
     }
 
+    if parsedOptions.hasArgument(.enableLegacyIos5Runtime) {
+      // The iOS 5 helper objects patch the 32-bit runtime/overlay split. armv7s
+      // and arm64 link a current stdlib whose Core and SDK already carry those
+      // entries, so only the armv7 slice takes the crt and helpers.
+      let legacy32 = targetTriple.archName == "armv7"
+      // Clang must not synthesize an LC_MAIN startup (iOS 6+). Supply the
+      // legacy crt explicitly. Only iOS 5 needs it: iOS 6 and newer load
+      // LC_MAIN, and crt1.3.1.o is a 32-bit armv7 object.
+      if legacy32 && linkerOutputType == .executable && targetTriple.osVersion.major < 6 {
+        let crt = VirtualPath.lookup(targetInfo.runtimeResourcePath.path)
+          .appending(components: "iphoneos", "crt1.3.1.o")
+        guard try fileSystem.exists(crt) else {
+          throw LegacyIOS5.ValidationError.missingCRT(crt.description)
+        }
+        commandLine.appendFlag("-Wl,-no_new_main")
+        commandLine.appendPath(crt)
+      }
+      if legacy32 {
+        let backports = VirtualPath.lookup(targetInfo.runtimeResourcePath.path)
+          .appending(components: "iphoneos", "libswiftLegacyIOS5Backports.a")
+        guard try fileSystem.exists(backports) else {
+          throw LegacyIOS5.ValidationError.missingBackports(backports.description)
+        }
+        // A normal archive input, not -force_load: extract only referenced
+        // backports, and permit newer runtimes to satisfy symbols themselves.
+        commandLine.appendPath(backports)
+      }
+      commandLine.appendFlag("-lobjc")
+      commandLine.appendFlag("-lSystem")
+    }
+
     // On Darwin, we only support libc++.
     var cxxCompatEnabled = parsedOptions.hasArgument(.enableExperimentalCxxInterop)
     if let cxxInteropMode = parsedOptions.getLastArgument(.cxxInteroperabilityMode) {
