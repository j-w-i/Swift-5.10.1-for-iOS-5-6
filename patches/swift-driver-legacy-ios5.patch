index 0000000..91205c6
--- /dev/null
+++ b/Sources/SwiftDriver/Driver/LegacyIOS5.swift
@@ -0,0 +1,81 @@
+//===--------------- LegacyIOS5.swift - Explicit legacy runtime ------------===//
+//
+// Licensed under Apache License v2.0 with Runtime Library Exception
+// See https://swift.org/LICENSE.txt for license information
+//
+//===----------------------------------------------------------------------===//
+
+import SwiftOptions
+import TSCBasic
+
+/// Validation is deliberately performed before querying the frontend, including
+/// for link-only invocations. Selecting an old deployment target alone must not
+/// select the legacy ABI or resource directory.
+enum LegacyIOS5 {
+  enum ValidationError: Error, DiagnosticData {
+    case unsupportedTarget
+    case unsupportedClassMarking
+    case unsupportedDeploymentTarget(String)
+    case disabledClassMarking
+    case staticMode
+    case missingCRT(String)
+    case missingBackports(String)
+
+    var description: String {
+      switch self {
+      case .unsupportedTarget:
+        return "legacy iOS 5 modes require an armv7, armv7s or arm64 Apple iOS device target without a target variant"
+      case .unsupportedClassMarking:
+        return "legacy iOS 5 class marking is an armv7 Objective-C class-ABI bridge; armv7s and arm64 use the backported declaration surface only"
+      case .unsupportedDeploymentTarget(let arch):
+        return "legacy \(arch) backports require an iOS 7.0 or newer deployment target; 64-bit devices never ran iOS 5/6"
+      case .disabledClassMarking:
+        return "-enable-legacy-ios5-runtime requires legacy iOS 5 class marking; remove -disable-legacy-ios5-class-marking"
+      case .staticMode:
+        return "-enable-legacy-ios5-runtime does not support -static, -static-stdlib, -static-executable, or -use-static-resource-dir"
+      case .missingBackports(let path):
+        return "legacy iOS 5 link requires '\(path)'; build and install libswiftLegacyIOS5Backports.a from LegacyRuntimeBackports.c in the legacy resource directory or specify -resource-dir"
+      case .missingCRT(let path):
+        return "legacy iOS 5 executable requires '\(path)'; install crt1.3.1.o in the legacy resource directory or specify -resource-dir"
+      }
+    }
+  }
+
+  static func validate(_ options: inout ParsedOptions, target: Triple?, targetVariant: Triple?) throws {
+    let runtime = options.hasArgument(.enableLegacyIos5Runtime)
+    let markingRequested = options.hasArgument(.enableLegacyIos5ClassMarking)
+    let marking = options.hasFlag(positive: .enableLegacyIos5ClassMarking,
+                                  negative: .disableLegacyIos5ClassMarking,
+                                  default: runtime)
+    guard runtime || marking else { return }
+    guard let target = target, target.vendor == .apple,
+          target.darwinPlatform == .iOS(.device),
+          targetVariant == nil else {
+      throw ValidationError.unsupportedTarget
+    }
+    let arch = target.archName
+    guard arch == "armv7" || arch == "armv7s" || arch == "arm64" else {
+      throw ValidationError.unsupportedTarget
+    }
+    if arch == "armv7" {
+      // The 32-bit class-marking bridge is what serves iOS 5/6 at the ObjC ABI level.
+      if runtime && !marking {
+        throw ValidationError.disabledClassMarking
+      }
+    } else {
+      if markingRequested && marking {
+        throw ValidationError.unsupportedClassMarking
+      }
+      guard runtime else { throw ValidationError.unsupportedTarget }
+      guard target.osVersion.major >= 7 else {
+        throw ValidationError.unsupportedDeploymentTarget(arch)
+      }
+    }
+    if runtime && (options.hasArgument(.static) ||
+        options.hasFlag(positive: .staticStdlib, negative: .noStaticStdlib, default: false) ||
+        options.hasFlag(positive: .staticExecutable, negative: .noStaticExecutable, default: false) ||
+        options.hasArgument(.useStaticResourceDir)) {
+      throw ValidationError.staticMode
+    }
+  }
+}
