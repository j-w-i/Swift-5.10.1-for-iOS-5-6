diff --git a/Tests/SwiftDriverTests/LegacyIOS5Tests.swift b/Tests/SwiftDriverTests/LegacyIOS5Tests.swift
new file mode 100644
index 0000000..06f8d38
--- /dev/null
+++ b/Tests/SwiftDriverTests/LegacyIOS5Tests.swift
@@ -0,0 +1,181 @@
+//===--------------- LegacyIOS5Tests.swift --------------------------------===//
+// Licensed under Apache License v2.0 with Runtime Library Exception
+
+import Foundation
+@_spi(Testing) @testable import SwiftDriver
+import SwiftDriverExecution
+import SwiftOptions
+import TSCBasic
+import XCTest
+
+final class LegacyIOS5Tests: XCTestCase {
+  private func options(_ args: [String]) throws -> ParsedOptions {
+    try OptionTable().parse(args, for: .batch)
+  }
+
+  func testOptionsAffectIncrementalBuild() throws {
+    for option in [Option.enableLegacyIos5Runtime, .enableLegacyIos5ClassMarking,
+                   .disableLegacyIos5ClassMarking] {
+      XCTAssertTrue(option.affectsIncrementalBuild)
+      var parsed = try options([option.spelling])
+      XCTAssertTrue(parsed.hasArgument(option))
+    }
+  }
+
+  func testValidationIsOptIn() throws {
+    for target in ["armv7-apple-ios5.0", "armv7-apple-ios7.0"] {
+      var parsed = try options(["-enable-legacy-ios5-runtime"])
+      try LegacyIOS5.validate(&parsed, target: Triple(target), targetVariant: nil)
+    }
+    var ordinary = try options([])
+    try LegacyIOS5.validate(&ordinary, target: Triple("x86_64-unknown-linux"), targetVariant: nil)
+    var disabled = try options(["-disable-legacy-ios5-class-marking"])
+    try LegacyIOS5.validate(&disabled, target: nil, targetVariant: nil)
+  }
+
+  func testInvalidTargetsAndModes() throws {
+    for target in ["arm64-apple-ios5.0", "armv7s-apple-ios5.0", "armv7-apple-ios5.0-simulator",
+                   "armv7-apple-tvos9.0", "armv7-apple-ios13.0-macabi", "armv7-unknown-linux"] {
+      var parsed = try options(["-enable-legacy-ios5-runtime"])
+      XCTAssertThrowsError(try LegacyIOS5.validate(&parsed, target: Triple(target), targetVariant: nil))
+    }
+    for mode in ["-static", "-static-stdlib", "-static-executable", "-disable-legacy-ios5-class-marking"] {
+      var parsed = try options(["-enable-legacy-ios5-runtime", mode])
+      XCTAssertThrowsError(try LegacyIOS5.validate(&parsed, target: Triple("armv7-apple-ios5.0"), targetVariant: nil))
+    }
+    var missingTarget = try options(["-enable-legacy-ios5-runtime"])
+    XCTAssertThrowsError(try LegacyIOS5.validate(&missingTarget, target: nil, targetVariant: nil))
+    var variant = try options(["-enable-legacy-ios5-runtime"])
+    XCTAssertThrowsError(try LegacyIOS5.validate(&variant, target: Triple("armv7-apple-ios5.0"),
+                                               targetVariant: Triple("arm64-apple-ios13.0-macabi")))
+  }
+
+  private func toolchain(_ fs: InMemoryFileSystem) throws -> DarwinToolchain {
+    let executor = try SwiftDriverExecutor(diagnosticsEngine: DiagnosticsEngine(),
+      processSet: ProcessSet(), fileSystem: fs, env: [:])
+    let result = DarwinToolchain(env: [:], executor: executor, fileSystem: fs)
+    result.overrideToolPath(.swiftCompiler, path: AbsolutePath("/toolchain/usr/bin/swift-frontend"))
+    result.overrideToolPath(.dynamicLinker, path: AbsolutePath("/toolchain/usr/bin/clang"))
+    return result
+  }
+
+  func testDeploymentFloorRequiresRuntimeOptIn() throws {
+    let tc = try toolchain(InMemoryFileSystem())
+    var ordinary = try options([])
+    XCTAssertThrowsError(try tc.validateDeploymentTarget(&ordinary,
+      targetTriple: Triple("armv7-apple-ios5.0"), compilerOutputType: .object))
+    var legacy = try options(["-enable-legacy-ios5-runtime"])
+    try tc.validateDeploymentTarget(&legacy, targetTriple: Triple("armv7-apple-ios5.0"), compilerOutputType: .object)
+    XCTAssertThrowsError(try tc.validateDeploymentTarget(&legacy,
+      targetTriple: Triple("armv7-apple-ios4.0"), compilerOutputType: .object))
+    var markingOnly = try options(["-enable-legacy-ios5-class-marking"])
+    XCTAssertThrowsError(try tc.validateDeploymentTarget(&markingOnly,
+      targetTriple: Triple("armv7-apple-ios5.0"), compilerOutputType: .object))
+  }
+
+  func testLegacyDeploymentDiagnosticNamesOptInOnlyForSupportedTargets() throws {
+    let tc = try toolchain(InMemoryFileSystem())
+    for target in ["armv7-apple-ios5.0", "armv7-apple-ios5.1.1", "armv7-apple-ios6.0"] {
+      for arguments in [[], ["-enable-legacy-ios5-class-marking"]] {
+        var parsed = try options(arguments)
+        XCTAssertThrowsError(try tc.validateDeploymentTarget(&parsed,
+          targetTriple: Triple(target), compilerOutputType: .object)) { error in
+          guard case DarwinToolchain.ToolchainValidationError.legacyIOSDeploymentRequiresOptIn = error else {
+            return XCTFail("Expected actionable opt-in diagnostic for \(target), got \(error)")
+          }
+          XCTAssertTrue(DarwinToolchain.ToolchainValidationError.legacyIOSDeploymentRequiresOptIn.description.contains("-enable-legacy-ios5-runtime"))
+        }
+      }
+    }
+    for target in ["arm64-apple-ios5.0", "armv7s-apple-ios6.0", "armv7-apple-ios6.0-simulator",
+                   "armv7-apple-ios6.0-macabi", "armv7-apple-ios4.0"] {
+      var parsed = try options([])
+      XCTAssertThrowsError(try tc.validateDeploymentTarget(&parsed,
+        targetTriple: Triple(target), compilerOutputType: .object)) { error in
+        guard case DarwinToolchain.ToolchainValidationError.osVersionBelowMinimumDeploymentTarget = error else {
+          return XCTFail("Expected unchanged generic deployment diagnostic for \(target), got \(error)")
+        }
+        XCTAssertFalse(String(describing: error).contains("-enable-legacy-ios5-runtime"))
+      }
+    }
+    var ordinary = try options([])
+    try tc.validateDeploymentTarget(&ordinary, targetTriple: Triple("armv7-apple-ios7.0"), compilerOutputType: .object)
+    for target in ["armv7-apple-ios5.0", "armv7-apple-ios6.0", "armv7-apple-ios7.0"] {
+      var legacy = try options(["-enable-legacy-ios5-runtime"])
+      try tc.validateDeploymentTarget(&legacy, targetTriple: Triple(target), compilerOutputType: .object)
+    }
+  }
+
+  func testTargetInfoForwardingAndExplicitResourceDirectory() throws {
+    let tc = try toolchain(InMemoryFileSystem())
+    let job = try tc.printTargetInfoJob(target: Triple("armv7-apple-ios5.0"), targetVariant: nil,
+      resourceDirPath: .absolute(AbsolutePath("/custom/resources")),
+      legacyIOS5Runtime: true, legacyIOS5ClassMarking: "-enable-legacy-ios5-class-marking",
+      swiftCompilerPrefixArgs: [])
+    XCTAssertTrue(job.commandLine.contains(.flag("-enable-legacy-ios5-runtime")))
+    XCTAssertTrue(job.commandLine.contains(.flag("-enable-legacy-ios5-class-marking")))
+    XCTAssertTrue(job.commandLine.contains(.path(.absolute(AbsolutePath("/custom/resources")))))
+    let ordinary = try tc.printTargetInfoJob(target: nil, targetVariant: nil, swiftCompilerPrefixArgs: [])
+    XCTAssertFalse(ordinary.commandLine.contains(.flag("-enable-legacy-ios5-runtime")))
+  }
+
+  private func targetInfo() throws -> FrontendTargetInfo {
+    let json = """
+    {"compilerVersion":"test", "target": {
+      "triple":"armv7-apple-ios5.0", "unversionedTriple":"armv7-apple-ios",
+      "moduleTriple":"armv7-apple-ios", "compatibilityLibraries":[], "librariesRequireRPath":true},
+      "paths":{"sdkPath":"/sdk", "runtimeLibraryPaths":[], "runtimeLibraryImportPaths":[],
+      "runtimeResourcePath":"/toolchain/usr/lib/swift_ios5"}}
+    """
+    return try JSONDecoder().decode(FrontendTargetInfo.self, from: Data(json.utf8))
+  }
+
+  func testLegacyLinkAndMissingCRT() throws {
+    let fs = InMemoryFileSystem()
+    let tc = try toolchain(fs)
+    let info = try targetInfo()
+    func link(_ legacy: Bool, _ type: LinkOutputType) throws -> [Job.ArgTemplate] {
+      var parsed = try options(legacy ? ["-enable-legacy-ios5-runtime"] : [])
+      var command: [Job.ArgTemplate] = []
+      _ = try tc.addPlatformSpecificLinkerArgs(to: &command, parsedOptions: &parsed,
+        linkerOutputType: type, inputs: [], outputFile: .absolute(AbsolutePath("/app")),
+        shouldUseInputFileList: false, lto: nil, sanitizers: [], targetInfo: info)
+      return command
+    }
+    XCTAssertThrowsError(try link(true, .executable))
+    let crt = AbsolutePath("/toolchain/usr/lib/swift_ios5/iphoneos/crt1.3.1.o")
+    try fs.createDirectory(crt.parentDirectory, recursive: true)
+    try fs.writeFileContents(crt, bytes: ByteString("crt"))
+    let backports = crt.parentDirectory.appending(component: "libswiftLegacyIOS5Backports.a")
+    for type in [LinkOutputType.executable, .dynamicLibrary] {
+      XCTAssertThrowsError(try link(true, type)) { error in
+        guard case LegacyIOS5.ValidationError.missingBackports(let path) = error else {
+          return XCTFail("Expected missing backports diagnostic, got \(error)")
+        }
+        XCTAssertTrue(path.contains("libswiftLegacyIOS5Backports.a"))
+        XCTAssertTrue(LegacyIOS5.ValidationError.missingBackports(path).description.contains("LegacyRuntimeBackports.c"))
+      }
+    }
+    // The absent-flag path must not require the archive.
+    XCTAssertNoThrow(try link(false, .executable))
+    try fs.writeFileContents(backports, bytes: ByteString("archive"))
+    let command = try link(true, .executable)
+    XCTAssertTrue(command.contains(.flag("-Wl,-no_new_main")))
+    XCTAssertTrue(command.contains(.path(.absolute(crt))))
+    XCTAssertTrue(command.contains(.flag("-lobjc")))
+    XCTAssertTrue(command.contains(.flag("-lSystem")))
+    XCTAssertTrue(command.contains(.path(.absolute(AbsolutePath("/sdk/usr/lib/swift_ios5")))))
+    XCTAssertTrue(command.contains(.path(.absolute(AbsolutePath("/usr/lib/swift_ios5")))))
+    for command in [command, try link(true, .dynamicLibrary)] {
+      XCTAssertEqual(command.filter { $0 == .path(.absolute(backports)) }.count, 1)
+      XCTAssertFalse(command.contains(.flag("-force_load")))
+      XCTAssertFalse(command.contains(.flag("-Wl,-force_load")))
+      XCTAssertFalse(command.contains(.flag("-all_load")))
+    }
+    XCTAssertFalse(try link(false, .executable).contains(.path(.absolute(backports))))
+    for command in [try link(false, .executable), try link(true, .dynamicLibrary)] {
+      XCTAssertFalse(command.contains(.flag("-Wl,-no_new_main")))
+      XCTAssertFalse(command.contains(.path(.absolute(crt))))
+    }
+  }
+}
